---
export interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
}

const { variant = "primary", size = "md", type = "button", disabled = false, class: className = "" } = Astro.props;

const variantClasses: Record<string, string> = {
  primary: "bg-base-900 text-base-100 hover:bg-base-700",
  secondary: "border border-base-400 text-base-900 hover:bg-base-200",
  ghost: "text-base-900 hover:bg-base-200",
};

const sizeClasses: Record<string, string> = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-5 py-2.5 text-base",
  lg: "px-7 py-3.5 text-lg",
};
---

<button
  type={type}
  disabled={disabled}
  class={`inline-flex items-center justify-center gap-2 rounded-lg font-mono transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-base-400 disabled:opacity-50 disabled:cursor-not-allowed ${variantClasses[variant]} ${sizeClasses[size]} ${className}`}
>
  <slot />
</button>
