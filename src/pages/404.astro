---
// layout
import MainLayout from "../shared/components/MainLayout.astro";

// components
import Container from "../shared/components/Container.astro";
import Heading from "../shared/components/Heading.astro";
import Text from "../shared/components/Text.astro";
import Link from "../shared/components/Link.astro";
---

<MainLayout 
    title="Page Not Found"
    description="404 page description"
>
    <Container variant={'xl'} class="text-center flex items-center">
        <div class="flex flex-col gap-4">
            <Heading tagName="h1" tagSize="h1">Page Not Found</Heading>
            <Text variant={'xl'} class="text-base-900">Oops! It seems the page you are trying to access is broken or does not exist!</Text>    
        </div>
        
        <Link variant={'button'} href="/">Go back to the homepage</Link>
    </Container>
</MainLayout>